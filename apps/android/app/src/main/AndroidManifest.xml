<?xml version="1.0" encoding="utf-8"?>
<!--
  主清单本身不声明任何权限：采集需要的权限与前台服务在 :platform 的清单里，合并进来；INTERNET 只来自 :modelmgmt（下载模型）与 :syncplatform（同步），
  NoNetworkManifestTest 检查合并后的清单里它的来源恰好是这两个。
  备份与换机迁移：allowBackup=false 只关掉云备份，Android 12+ 的换机迁移要靠 dataExtractionRules 才真的关上，
  Android 11 及以下靠 fullBackupContent；两份规则把每个域都整个排除。敏感文件另外放在 noBackupFilesDir（NoBackupStorage）。
  BackupRulesTest 与 StorageLocationGuardTest 检查这些。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".AuriApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="Auri"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
