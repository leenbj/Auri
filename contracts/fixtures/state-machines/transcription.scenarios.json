{
  "schema_version": "1.2",
  "machine": "transcription",
  "scenarios": [
    {
      "name": "straight-success",
      "description": "排队、运行、得到正文。",
      "initial_state": "QUEUED",
      "steps": [
        {
          "event": "RUN_STARTED",
          "expect": "transition",
          "state_after": "RUNNING"
        },
        {
          "event": "RESULT_TEXT",
          "expect": "transition",
          "state_after": "SUCCEEDED"
        },
        {
          "event": "CANCEL",
          "expect": "ignored",
          "state_after": "SUCCEEDED"
        }
      ]
    },
    {
      "name": "wait-for-model",
      "description": "没有模型时等待下载，不上云。",
      "initial_state": "QUEUED",
      "steps": [
        {
          "event": "MODEL_MISSING",
          "expect": "transition",
          "state_after": "WAITING_MODEL"
        },
        {
          "event": "MODEL_READY",
          "expect": "transition",
          "state_after": "QUEUED"
        },
        {
          "event": "RUN_STARTED",
          "expect": "transition",
          "state_after": "RUNNING"
        },
        {
          "event": "RESULT_NO_SPEECH",
          "expect": "transition",
          "state_after": "NO_SPEECH"
        },
        {
          "event": "CANCEL",
          "expect": "ignored",
          "state_after": "NO_SPEECH"
        }
      ]
    },
    {
      "name": "wait-for-resources",
      "description": "资源不足时等待，包括运行中被打断。",
      "initial_state": "QUEUED",
      "steps": [
        {
          "event": "RESOURCES_LOW",
          "expect": "transition",
          "state_after": "WAITING_RESOURCES"
        },
        {
          "event": "RESOURCES_OK",
          "expect": "transition",
          "state_after": "QUEUED"
        },
        {
          "event": "RUN_STARTED",
          "expect": "transition",
          "state_after": "RUNNING"
        },
        {
          "event": "RESOURCES_LOW",
          "expect": "transition",
          "state_after": "WAITING_RESOURCES"
        },
        {
          "event": "CANCEL",
          "expect": "transition",
          "state_after": "CANCELLED"
        },
        {
          "event": "CANCEL",
          "expect": "ignored",
          "state_after": "CANCELLED"
        }
      ]
    },
    {
      "name": "retry-then-fail",
      "description": "可重试的失败重试一次后永久失败。",
      "initial_state": "QUEUED",
      "steps": [
        {
          "event": "RUN_STARTED",
          "expect": "transition",
          "state_after": "RUNNING"
        },
        {
          "event": "RETRYABLE_ERROR",
          "expect": "transition",
          "state_after": "RETRY_SCHEDULED"
        },
        {
          "event": "RETRY_DUE",
          "expect": "transition",
          "state_after": "QUEUED"
        },
        {
          "event": "RUN_STARTED",
          "expect": "transition",
          "state_after": "RUNNING"
        },
        {
          "event": "PERMANENT_ERROR",
          "expect": "transition",
          "state_after": "FAILED"
        },
        {
          "event": "CANCEL",
          "expect": "ignored",
          "state_after": "FAILED"
        }
      ]
    },
    {
      "name": "cancel-everywhere",
      "description": "各个未结束的状态都可以取消。",
      "initial_state": "QUEUED",
      "steps": [
        {
          "event": "CANCEL",
          "expect": "transition",
          "state_after": "CANCELLED"
        }
      ]
    },
    {
      "name": "cancel-waiting-model",
      "description": "等待模型时取消。",
      "initial_state": "WAITING_MODEL",
      "steps": [
        {
          "event": "CANCEL",
          "expect": "transition",
          "state_after": "CANCELLED"
        }
      ]
    },
    {
      "name": "cancel-running",
      "description": "运行中取消。",
      "initial_state": "RUNNING",
      "steps": [
        {
          "event": "CANCEL",
          "expect": "transition",
          "state_after": "CANCELLED"
        }
      ]
    },
    {
      "name": "cancel-retry-scheduled",
      "description": "等待重试时取消。",
      "initial_state": "RETRY_SCHEDULED",
      "steps": [
        {
          "event": "CANCEL",
          "expect": "transition",
          "state_after": "CANCELLED"
        }
      ]
    },
    {
      "name": "finished-job-cannot-rerun",
      "description": "已结束的任务不能再运行或改写结果；重转录是新任务。",
      "initial_state": "SUCCEEDED",
      "steps": [
        {
          "event": "RUN_STARTED",
          "expect": "rejected",
          "state_after": "SUCCEEDED"
        },
        {
          "event": "RESULT_TEXT",
          "expect": "rejected",
          "state_after": "SUCCEEDED"
        }
      ]
    },
    {
      "name": "late-result-after-cancel",
      "description": "取消之后迟到的结果不得写入。",
      "initial_state": "RUNNING",
      "steps": [
        {
          "event": "CANCEL",
          "expect": "transition",
          "state_after": "CANCELLED"
        },
        {
          "event": "RESULT_TEXT",
          "expect": "rejected",
          "state_after": "CANCELLED"
        }
      ]
    }
  ]
}
