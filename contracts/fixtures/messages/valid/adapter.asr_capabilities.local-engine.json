{
  "schema": "adapter.schema.json#/$defs/asr_capabilities",
  "expect": "valid",
  "description": "一个本地引擎声明的能力。",
  "instance": {
    "execution_location": "on_device",
    "engine": "sherpa-onnx",
    "model_id": "fixture-local-model",
    "model_version": "fixture-pinned-version",
    "languages": [
      "zh-CN",
      "en"
    ],
    "accepts_recorded_file": true,
    "formats": [
      {
        "encoding": "pcm_s16le",
        "sample_rate_hz": 16000,
        "channels": 1
      }
    ],
    "streaming": false,
    "timestamp_granularity": "segment",
    "limits": {
      "max_audio_duration_ms": 7200000,
      "max_concurrent_jobs": 1
    },
    "cancel_support": "best_effort"
  }
}
