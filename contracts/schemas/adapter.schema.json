{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auri.invalid/1.0/adapter.schema.json",
  "title": "原生适配器类型",
  "description": "PRD 第 17.1 节。三端原生层与共享层之间传递的八个类型的跨平台语义。它们在进程内传递，不是网络消息，因此不带 schema_version。原生层与共享层都要校验，不信任另一端已经检查。",
  "$defs": {
    "monotonic_ns": {
      "description": "单调时钟读数（纳秒）。只用于排序和计算间隔，不受手机校时影响。",
      "type": "integer",
      "minimum": 0
    },
    "counter": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "description": "Capture Session 原始时间线上的一段，毫秒。",
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "$ref": "common.schema.json#/$defs/duration_ms" },
        "end_ms": { "$ref": "common.schema.json#/$defs/duration_ms" }
      }
    },
    "normalized_control_event": {
      "title": "NormalizedControlEvent",
      "description": "一个平台事件归一化后的业务命令。只描述平台实际给出的事件，不猜测物理手势，也不猜测左右耳（FR-HS-001）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "source",
        "platform_event",
        "command",
        "monotonic_ns",
        "sequence",
        "profile_id",
        "profile_version",
        "raw_event_id"
      ],
      "properties": {
        "event_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "source": {
          "description": "headset_remote：平台能确认事件来自耳机；unknown_remote：媒体命令的来源无法验证（例如也可能来自锁屏控件）；volume_gesture：音量变化（ADR-0014）；screen_control：App 内的屏幕操作。",
          "enum": ["headset_remote", "unknown_remote", "volume_gesture", "screen_control"]
        },
        "platform_event": { "$ref": "common.schema.json#/$defs/platform_event" },
        "command": { "$ref": "common.schema.json#/$defs/business_command" },
        "monotonic_ns": { "$ref": "#/$defs/monotonic_ns" },
        "sequence": {
          "description": "命令进入串行调度器的单调递增序号。",
          "$ref": "#/$defs/counter"
        },
        "profile_id": {
          "description": "做出这次映射的 Headset Profile；屏幕操作不经过档案，为 null。",
          "type": ["string", "null"],
          "maxLength": 100
        },
        "profile_version": { "type": ["integer", "null"], "minimum": 1 },
        "raw_event_id": {
          "description": "可获得时关联的平台原始事件标识，用于去重；没有则为 null。",
          "type": ["string", "null"],
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "description": "音量变化只能用来停止，不能用来开始。",
          "if": { "properties": { "platform_event": { "const": "volume_change" } }, "required": ["platform_event"] },
          "then": {
            "properties": {
              "command": { "enum": ["STOP", "IGNORE"] },
              "source": { "const": "volume_gesture" }
            }
          }
        },
        {
          "if": { "properties": { "platform_event": { "const": "screen_button" } }, "required": ["platform_event"] },
          "then": { "properties": { "source": { "const": "screen_control" } } }
        },
        {
          "description": "经过耳机档案映射的事件必须写明是哪个档案的哪个版本。",
          "if": { "properties": { "source": { "const": "screen_control" } }, "required": ["source"] },
          "else": {
            "properties": {
              "profile_id": { "type": "string", "minLength": 1 },
              "profile_version": { "type": "integer" }
            }
          }
        }
      ]
    },
    "capture_eligibility": {
      "title": "CaptureEligibility",
      "description": "当前能否开始录音。未知必须显式表达，未知不等于允许。",
      "type": "object",
      "additionalProperties": false,
      "required": ["permission", "lifecycle", "can_start", "reason"],
      "properties": {
        "permission": { "enum": ["granted", "denied", "undetermined", "restricted", "unknown"] },
        "lifecycle": { "enum": ["foreground", "background", "locked", "unknown"] },
        "can_start": { "enum": ["yes", "no", "unknown"] },
        "reason": {
          "description": "不能开始时的原因；能开始时为 null。",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/error_code" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "can_start": { "const": "yes" } }, "required": ["can_start"] },
          "then": {
            "properties": {
              "permission": { "const": "granted" },
              "reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "can_start": { "const": "no" } }, "required": ["can_start"] },
          "then": { "properties": { "reason": { "type": "string" } } }
        }
      ]
    },
    "prepared_input": {
      "title": "PreparedInput",
      "description": "向系统请求蓝牙输入后得到的准备句柄。它只说明请求发出去了，不代表实际来源已经验证；验证结论只来自 RouteChangeEvent。",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "generation", "requested_device", "request_status"],
      "properties": {
        "operation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "generation": {
          "description": "本次准备操作的代数；已取消或更旧代数的回调不得生效。",
          "$ref": "#/$defs/counter"
        },
        "requested_device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_name", "platform_device_ref"],
          "properties": {
            "display_name": { "type": ["string", "null"], "maxLength": 200 },
            "platform_device_ref": {
              "description": "平台给出的设备引用；显示名称和 MAC 地址都不是跨平台可靠身份。",
              "type": ["string", "null"],
              "maxLength": 200
            }
          }
        },
        "request_status": { "enum": ["requested", "accepted_by_system", "rejected_by_system", "unknown"] }
      }
    },
    "capture_handle": {
      "title": "CaptureHandle",
      "description": "一次已开闸的采集的句柄。只有 generation 与 verified_route_epoch 都匹配时才允许写入音频。",
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_session_id", "generation", "verified_route_epoch", "gate_state"],
      "properties": {
        "capture_session_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/counter" },
        "verified_route_epoch": {
          "description": "路由被确认时的 route_epoch；路由一变化，epoch 递增，这个句柄随即失效。",
          "$ref": "#/$defs/counter"
        },
        "gate_state": { "enum": ["open", "closed"] }
      }
    },
    "route_change_event": {
      "title": "RouteChangeEvent",
      "description": "系统观测到的一次输入路由变化，即 Route Evidence 的来源。记录系统观测，不伪造固件或设备标识。验证状态不是 verified 时必须立即关闸。",
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_session_id", "epoch", "observed_input", "observed_at_monotonic_ns", "verification_state"],
      "properties": {
        "capture_session_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "epoch": { "$ref": "#/$defs/counter" },
        "observed_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_type", "display_name"],
          "properties": {
            "route_type": { "$ref": "common.schema.json#/$defs/observed_input_route_type" },
            "display_name": { "type": ["string", "null"], "maxLength": 200 }
          }
        },
        "observed_at_monotonic_ns": { "$ref": "#/$defs/monotonic_ns" },
        "verification_state": {
          "description": "verified：实际输入确实是所选蓝牙耳机；mismatch：实际输入是别的来源；unknown：无法确认。“已配对”“已连接”都不是 verified 的依据。",
          "enum": ["verified", "mismatch", "unknown"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verification_state": { "const": "verified" } }, "required": ["verification_state"] },
          "then": {
            "properties": {
              "observed_input": {
                "properties": { "route_type": { "$ref": "common.schema.json#/$defs/input_route_type" } }
              }
            }
          }
        }
      ]
    },
    "audio_chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "sequence", "sha256", "route_epoch", "start_ms", "end_ms"],
      "properties": {
        "chunk_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/counter" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256_hex" },
        "route_epoch": {
          "description": "写入这段音频时已确认的 route_epoch；未确认路由的帧不得进入任何 chunk。",
          "$ref": "#/$defs/counter"
        },
        "start_ms": { "$ref": "common.schema.json#/$defs/duration_ms" },
        "end_ms": { "$ref": "common.schema.json#/$defs/duration_ms" }
      }
    },
    "recording_result": {
      "title": "RecordingResult",
      "description": "一次路由已确认的 Capture Session 封存后的结果，对应一个 Record。整段无人说话时 chunks 和 verified_ranges 为空（ADR-0016）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "capture_session_id",
        "status",
        "end_reason",
        "capture_duration_ms",
        "speech_duration_ms",
        "chunks",
        "verified_ranges",
        "discarded_ranges"
      ],
      "properties": {
        "record_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "capture_session_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "status": { "$ref": "common.schema.json#/$defs/capture_status" },
        "end_reason": { "$ref": "common.schema.json#/$defs/end_reason" },
        "capture_duration_ms": { "$ref": "common.schema.json#/$defs/duration_ms" },
        "speech_duration_ms": {
          "description": "等于各 verified_ranges 时长之和。",
          "$ref": "common.schema.json#/$defs/duration_ms"
        },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/audio_chunk" } },
        "verified_ranges": {
          "description": "保留下来的音频在原始时间线上的位置：路由已确认且有人声。提交 Revision 时即 speech_segments。",
          "type": "array",
          "items": { "$ref": "#/$defs/time_range" }
        },
        "discarded_ranges": {
          "description": "没有保留的时间段及原因。",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_ms", "end_ms", "reason"],
            "properties": {
              "start_ms": { "$ref": "common.schema.json#/$defs/duration_ms" },
              "end_ms": { "$ref": "common.schema.json#/$defs/duration_ms" },
              "reason": {
                "description": "silence：VAD 判为无人声；route_unverified：该时间段的输入路由未确认或已失配。",
                "enum": ["silence", "route_unverified"]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "end_reason": { "enum": ["headset_command", "volume_gesture", "screen_control", "duration_limit"] }
            },
            "required": ["end_reason"]
          },
          "then": { "properties": { "status": { "const": "complete" } } },
          "else": { "properties": { "status": { "const": "partial" } } }
        }
      ]
    },
    "asr_capabilities": {
      "title": "AsrCapabilities",
      "description": "一个转录引擎声明的能力（FR-ASR-001）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_location",
        "engine",
        "model_id",
        "model_version",
        "languages",
        "accepts_recorded_file",
        "formats",
        "streaming",
        "timestamp_granularity",
        "limits",
        "cancel_support"
      ],
      "properties": {
        "execution_location": { "$ref": "common.schema.json#/$defs/execution_location" },
        "engine": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
        },
        "accepts_recorded_file": {
          "description": "能否转录已经录好的音频。不能的引擎不得通过重新打开麦克风来代替。",
          "type": "boolean"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["encoding", "sample_rate_hz", "channels"],
            "properties": {
              "encoding": { "enum": ["pcm_s16le", "pcm_f32le"] },
              "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 192000 },
              "channels": { "type": "integer", "minimum": 1, "maximum": 2 }
            }
          }
        },
        "streaming": { "type": "boolean" },
        "timestamp_granularity": { "enum": ["none", "segment", "word"] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_audio_duration_ms", "max_concurrent_jobs"],
          "properties": {
            "max_audio_duration_ms": {
              "description": "单次任务能接受的最长音频；没有限制为 null。",
              "type": ["integer", "null"],
              "minimum": 1
            },
            "max_concurrent_jobs": { "type": "integer", "minimum": 1 }
          }
        },
        "cancel_support": {
          "description": "none：不能取消；best_effort：可以请求取消，不保证立即停止；immediate：取消后立即停止。",
          "enum": ["none", "best_effort", "immediate"]
        }
      }
    },
    "asr_task_handle": {
      "title": "AsrTaskHandle",
      "description": "一个已提交的转录任务的句柄。一次重转录是一个新的 job_id。",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "provider_id", "provider_job_id", "config_revision"],
      "properties": {
        "job_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "provider_job_id": {
          "description": "远端服务返回的任务标识，与内部 job_id 分离；本地转录没有，必须显式写 null。",
          "type": ["string", "null"],
          "maxLength": 200
        },
        "config_revision": {
          "description": "提交任务时所用配置快照的版本。",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
